# Supply-chain hardening:
# - save-exact: dependencies are pinned to exact versions; upgrades are always
#   a deliberate, reviewable diff — never an automatic drift to a new release.
# - ignore-scripts: npm packages cannot run arbitrary install/postinstall
#   scripts on this machine or in CI (the primary payload vector in recent
#   npm supply-chain attacks). Our own "npm run" scripts still work.
save-exact=true
ignore-scripts=true
